<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- صلاحية استقبال إشعارات آبل. "production" هي البيئة الصح
	     للنسخ المبنية للتوزيع (TestFlight والمتجر). النسخ المبنية
	     من Xcode على جهاز مطوّر تستعمل "development". -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
