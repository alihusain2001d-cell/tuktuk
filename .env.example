# انسخ هذا الملف باسم .env واملأ القيم الحقيقية (لا ترفعه أبداً لأي مكان عام)

# رابط الاتصال بقاعدة بيانات PostgreSQL (من Railway)
DATABASE_URL=

# مفتاح الدخول للوحة تحكم الأدمن
ADMIN_KEY=

# وضع تطوير الـ OTP — يخلي كود التحقق يظهر بالشاشة بدل ما يرسل SMS حقيقي
# خليه true وحنا نجرب، وتذكر تحوله false قبل الإطلاق الحقيقي
OTP_DEV_MODE=true

# مفتاح OTPIQ لإرسال كود التحقق فعلياً (واتساب/SMS) — من docs.otpiq.com
# لو تركته فاضي، الكود يطبع بسجل السيرفر بس (وضع تجربة)
OTPIQ_API_KEY=

# مفاتيح إشعارات المتصفح (Web Push) — تتولد مرة وحدة بالأمر: npx web-push generate-vapid-keys
# لازم نفس القيم بالضبط على السيرفر المحلي وعلى Railway (لو تغيرت، الاشتراكات القديمة تنكسر)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# مفتاح LocationIQ للبحث عن المواقع (اختياري) — لو تركته فاضي، البحث يشتغل تلقائياً بـ OpenStreetMap المجاني
# حساب مجاني من my.locationiq.com/register (٥٠٠٠ طلب باليوم مجاناً)
LOCATIONIQ_API_KEY=

PORT=3000
